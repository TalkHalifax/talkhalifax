{
  "agent": "site-builder",
  "level": "L2",
  "tools": ["Read", "Glob", "Grep", "Edit", "Write", "Bash", "WebFetch"],
  "edit": {
    "allow": [
      "public/app.js",
      "public/index.html",
      "public/sw.js",
      "public/manifest.webmanifest",
      "public/icons/**",
      "public/styles.css",
      "public/views/**",
      "public/api.js",
      "public/chat.js",
      "docs/DESIGN-SYSTEM.md"
    ],
    "deny": []
  },
  "bash": [
    ["npm", "test"],
    ["npm", "run", "test:e2e"],
    ["npx", "tsc", "--noEmit"],
    ["npx", "tsc", "-p", "test"],
    ["npx", "wrangler", "d1", "migrations", "apply", "talkhalifax", "--local"],
    ["npx", "wrangler", "dev"],
    ["git", "status"],
    ["git", "status", "--short"],
    ["git", "diff"],
    ["git", "diff", "--stat"],
    ["git", "branch", "--show-current"],
    ["git", "checkout", "-b", "re:^site/[a-z0-9._-]+$"],
    ["git", "add", "public/app.js"],
    ["git", "add", "public/index.html"],
    ["git", "add", "public/sw.js"],
    ["git", "add", "public/manifest.webmanifest"],
    ["git", "add", "re:^public/icons/[a-z0-9_-][a-z0-9._-]*$"],
    ["git", "add", "public/styles.css"],
    ["git", "add", "re:^public/views/[a-z0-9-]+(/[a-z0-9-]+)*\\.js$"],
    ["git", "add", "public/api.js"],
    ["git", "add", "public/chat.js"],
    ["git", "add", "docs/DESIGN-SYSTEM.md"],
    ["git", "commit", "-m", "*"]
  ],
  "webfetch": ["developer.mozilla.org", "web.dev"]
}
