{
  "agent": "platform-builder",
  "level": "L2",
  "tools": ["Read", "Glob", "Grep", "Edit", "Write", "Bash", "TaskStop", "WebFetch"],
  "edit": {
    "allow": [
      "src/index.ts",
      "src/env.ts",
      "src/github-jobs.ts",
      "src/text-modules.d.ts",
      "src/routes/**",
      "test/unit/helpers.ts",
      "test/unit/setup.ts",
      "test/unit/headers.test.ts",
      "test/unit/github-jobs.test.ts",
      "protected-drafts/test/e2e/**"
    ],
    "deny": []
  },
  "bash": [
    ["npm", "test"],
    ["npm", "run", "test:e2e"],
    ["npx", "tsc", "--noEmit"],
    ["npx", "tsc", "-p", "test"],
    ["npx", "wrangler", "d1", "migrations", "apply", "talkhalifax", "--local"],
    ["npx", "wrangler", "dev"],
    ["node", "--check", "re:^public/[a-z0-9-]+(/[a-z0-9-]+)*\\.js$"],
    ["git", "status"],
    ["git", "status", "--short"],
    ["git", "diff"],
    ["git", "diff", "--stat"],
    ["git", "branch", "--show-current"],
    ["git", "checkout", "-b", "re:^platform/[a-z0-9._-]+$"],
    ["git", "add", "src/index.ts"],
    ["git", "add", "src/env.ts"],
    ["git", "add", "src/github-jobs.ts"],
    ["git", "add", "src/text-modules.d.ts"],
    ["git", "add", "re:^src/routes/[a-z0-9-]+(/[a-z0-9-]+)*\\.ts$"],
    ["git", "add", "test/unit/helpers.ts"],
    ["git", "add", "test/unit/setup.ts"],
    ["git", "add", "test/unit/headers.test.ts"],
    ["git", "add", "test/unit/github-jobs.test.ts"],
    ["git", "add", "re:^protected-drafts/test/e2e/[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"],
    ["git", "commit", "-m", "*"]
  ],
  "webfetch": ["developers.cloudflare.com", "developer.mozilla.org"]
}
