{
  "agent": "events-builder",
  "level": "L2",
  "tools": [
    "Read",
    "Glob",
    "Grep",
    "LS",
    "Edit",
    "Write",
    "NotebookEdit",
    "Bash",
    "WebFetch",
    "PowerShell",
    "Task",
    "Agent",
    "mcp__talkhalifax__list_leads"
  ],
  "edit": {
    "allow": [
      "src/events.ts",
      "public/events.js",
      "test/**",
      "docs/*.md",
      "notebooks/**",
      ".claude/**",
      ".github/**",
      "migrations/**",
      "CLAUDE.md",
      ".git/**",
      ".mcp.json",
      "package.json",
      "package-lock.json",
      "wrangler.jsonc",
      "admin/**",
      ".gitignore",
      ".gitattributes",
      "vitest.config.ts",
      "tsconfig.json",
      ".vscode/**",
      "agent-drafts/**",
      "node_modules/**",
      "scripts/**"
    ],
    "deny": [
      "test/unit/secret-*.ts"
    ]
  },
  "bash": [
    [
      "npm",
      "test"
    ],
    [
      "npm",
      "run",
      "test:hooks"
    ],
    [
      "git",
      "status"
    ],
    [
      "git",
      "add",
      "*"
    ],
    [
      "git",
      "add",
      "*",
      "*"
    ],
    [
      "git",
      "branch"
    ],
    [
      "git",
      "branch",
      "*"
    ],
    [
      "git",
      "diff",
      "*"
    ],
    [
      "npx",
      "vitest",
      "run"
    ],
    [
      "npx",
      "wrangler",
      "types"
    ],
    [
      "npm",
      "run",
      "agents:promote"
    ],
    [
      "node",
      "scripts/promote-agent-drafts.mjs"
    ],
    [
      "cat",
      "*",
      "*"
    ],
    [
      "git",
      "checkout",
      "-b",
      "re:^events/[a-z0-9._-]+$"
    ],
    [
      "git",
      "switch",
      "-c",
      "re:^events/[a-z0-9._-]+$"
    ],
    [
      "git",
      "commit",
      "-m",
      "*"
    ],
    [
      "git",
      "push",
      "origin",
      "re:^events/[a-z0-9._-]+$"
    ],
    [
      "git",
      "push",
      "-u",
      "origin",
      "re:^events/[a-z0-9._-]+$"
    ],
    [
      "git",
      "push",
      "--set-upstream",
      "origin",
      "re:^events/[a-z0-9._-]+$"
    ],
    [
      "git",
      "push",
      "--dry-run",
      "origin",
      "re:^events/[a-z0-9._-]+$"
    ],
    [
      "git",
      "push",
      "-un",
      "origin",
      "re:^events/[a-z0-9._-]+$"
    ],
    [
      "gh",
      "**"
    ],
    [
      "npx",
      "wrangler",
      "d1",
      "migrations",
      "apply",
      "talkhalifax",
      "--local"
    ],
    [
      "npx",
      "wrangler",
      "d1",
      "execute",
      "talkhalifax",
      "--local",
      "--command",
      "*"
    ],
    [
      "npx",
      "wrangler",
      "dev",
      "--persist-to",
      ".wrangler/state"
    ],
    [
      "npx",
      "wrangler",
      "dev",
      "--persist-to=.wrangler/state"
    ],
    [
      "cat",
      "*"
    ],
    [
      "echo",
      "**"
    ],
    [
      "FOO=bar",
      "npm",
      "test"
    ]
  ],
  "webfetch": [
    "developers.cloudflare.com"
  ],
  "agents": [
    "qa-tester",
    "no-policy-agent"
  ],
  "expires": {
    "push-grant": "2026-12-31"
  }
}
