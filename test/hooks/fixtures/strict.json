{
  "agent": "strict",
  "level": "L2",
  "tools": ["Read", "Edit", "Bash", "WebFetch"],
  "edit": { "allow": ["src/events.ts"] },
  "bash": [
    ["npm", "test"],
    ["git", "checkout", "-b", "re:^events/[a-z0-9._-]+$"],
    ["git", "commit", "-m", "*"],
    ["npx", "wrangler", "dev"],
    ["npx", "wrangler", "dev", "--port", "re:[0-9]+"],
    ["npx", "wrangler", "dev", "--persist-to", ".wrangler/state"]
  ],
  "webfetch": ["developers.cloudflare.com"]
}
