// The admin site: a separate Worker on the same database, behind the editor's username and password (the ADMIN_USER and
// ADMIN_PASSWORD secrets), or Cloudflare Access once that's set up. Its address (admin.talkhalifax.ca) is a custom
// domain set in the dashboard, like the main site's.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "talkhalifax-admin",
  "account_id": "5b365e1eb102c26b07e110dae02fbfa9",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // No workers.dev or preview address: only the one address the editor knows about.
  "workers_dev": false,
  "preview_urls": false,

  // Sign-in attempts per IP address: enough for typos, too few for guessing a long password.
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],

  // The Worker runs first so the page itself is behind the sign-in check too.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  "d1_databases": [
    { "binding": "DB", "database_name": "talkhalifax", "database_id": "11e74fb3-39eb-42ac-9f0b-620d5c3d47d2" }
  ],
  "observability": { "enabled": true }
}
